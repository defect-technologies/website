# defect.tech/admin settings. Set these in the Vercel project; copy to .env.local to run locally.
# Anything left empty shows up on the admin's Projects page as "Not connected".

# --- Required ---------------------------------------------------------------

# Neon Postgres (Vercel Marketplace). Leave empty locally to use the built-in PGlite database in .data/.
# After changing the schema: npx drizzle-kit generate, then DATABASE_URL=... npm run db:migrate
DATABASE_URL=

# Signs session cookies and seals Gmail refresh tokens. openssl rand -base64 32
AUTH_SECRET=

# The only two Google accounts allowed into /admin, comma-separated.
ADMIN_EMAILS=

# Where the site lives. Used for OAuth redirects and the defect.tech/p/<code> links in emails.
SITE_URL=https://defect.tech

# --- Founder sign-in --------------------------------------------------------
# Google Cloud > APIs & Services > Credentials > OAuth client (Web application).
# Scopes: openid, email, profile only, so the app can be published without review.
# Authorized redirect URI: https://defect.tech/api/auth/google/callback
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=

# --- Gmail (sending and reading outreach) -----------------------------------
# A second OAuth client, in a Google Cloud project owned by the sending domain's
# Workspace, with the consent screen set to Internal. Internal apps can use the
# Gmail scopes without Google's review, and their refresh tokens don't expire
# after 7 days the way an External app's do while it's in Testing.
# Enable the Gmail API. Redirect URI: https://defect.tech/api/mailboxes/callback
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=

# --- Engine and cron --------------------------------------------------------
# Shared with core/engine as DEFECT_ENGINE_TOKEN, so build_preview.sh can report new previews.
ENGINE_TOKEN=
# Vercel Cron sends this as a bearer token to /api/cron/sync every 30 minutes.
CRON_SECRET=

# --- Read-only connections --------------------------------------------------
# Stripe restricted key: read Checkout Sessions, Customers, Subscriptions. Nothing else.
STRIPE_API_KEY=
# Vercel token, team ID, and the previews project (defect-previews).
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PREVIEW_PROJECT=defect-previews
# Healthchecks.io read-only API key (Project settings > API access).
HEALTHCHECKS_API_KEY=
# Read-only connection to the client-content database, for the Site changes card.
# Created by site-kit: CLIENT_DB_ADMIN_URL=… npx defect-sites-db reader --project website
SITES_DATABASE_URL=

# --- Editor sign-in links (defect.tech/edit/sign-in) -------------------------
# Each client site on site-kit has its own editor at /edit. Owners get in with
# a link we email from here: https://<their site>/edit/enter?token=..., a token
# signed with EDITOR_SECRET that works for 10 minutes. Under `next dev` the link
# is printed in the terminal instead. Until all three are set, /edit/sign-in
# says email sign-in isn't switched on yet.
SIGN_IN_EMAIL_API_KEY=
# Resend sending-only key above. The From line is on send.defect.tech, verified in Resend:
# Defect Technologies <sign-in@send.defect.tech>
SIGN_IN_EMAIL_FROM=
# The same value as EDITOR_SECRET on every client site (site-kit's promote.mjs sets it there).
# openssl rand -base64 48
# Locally, leaving it empty uses site-kit's development secret, so links work
# against a starter run with SITE_MODE=live EDITOR_DEV=1.
EDITOR_SECRET=

# --- Local only -------------------------------------------------------------
# 1 under `next dev` adds "Sign in without Google" and a fake outbox. Ignored in production builds.
ADMIN_DEV_SIGN_IN=
